+
+// withoutNonArmadaAllocations returns a copy of ex whose nodes have no unallocatable resources. The submit
+// check asks whether a job could ever fit, so resources held by pods that Armada does not manage are treated
+// as available, in the same way as cordoned nodes (RemoveCordonTaint): such pods are often temporary, and a
+// job that fits once they finish should stay queued rather than be rejected. The scheduling cycle still
+// subtracts these resources when it places jobs.
+func withoutNonArmadaAllocations(ex *schedulerobjects.Executor) *schedulerobjects.Executor {
+	out := *ex
+	out.Nodes = make([]*schedulerobjects.Node, len(ex.Nodes))
+	for i, n := range ex.Nodes {
+		c := *n
+		c.UnallocatableResources = nil
+		out.Nodes[i] = &c
+	}
+	return &out
+}
