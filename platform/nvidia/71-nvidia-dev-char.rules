# Installed by host-gpu-setup.sh on every GPU node (from install-os-updates.sh).
#
# Recreate /dev/char/<major>:<minor> symlinks for the NVIDIA devices whenever
# the driver binds. Without them, a systemd reload (which any package upgrade
# with a unit file triggers) rebuilds every container's device cgroup from
# systemd's own list, and running GPU containers lose /dev/nvidia* with
# "Failed to initialize NVML: Unknown Error". The runtime can only register a
# device with systemd through its /dev/char path, and the NVIDIA device nodes
# are made by nvidia-modprobe, not udev, so the links do not exist by default.
# Hit on cirrus 2026-09-28: stt, a jupyter GPU server and gpu-mcp-test all lost
# the GPU during the first unattended-upgrades run. See NVIDIA container
# toolkit troubleshooting, "containers losing access to GPUs".
ACTION=="add", DEVPATH=="/bus/pci/drivers/nvidia", RUN+="__NVIDIA_CTK__ system create-dev-char-symlinks --create-all"
